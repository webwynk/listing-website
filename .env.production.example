# ==============================================================================
# 🌟 GlamBook — Production Environment Variables Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file as .env.production on your hosting provider (e.g. Vercel dashboard).
# 2. Fill in your live production credentials from Supabase, Resend, and your registered domain.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled database connection string (Port 6543, Transaction mode for Serverless/Edge)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct database connection string (Port 5432, Session mode for Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTH & STORAGE
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase Public Anon Key (Safe for client-side browser usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Secret (CRITICAL: Server-side only, bypasses RLS for Admin APIs)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. APPLICATION & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# Production canonical URL used for sitemap generation, OpenGraph metadata, and email links
NEXT_PUBLIC_APP_URL="https://glambook.in"

# Runtime Environment
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL SERVICE (Resend)
# ------------------------------------------------------------------------------
# Resend API Key for sending verification, password resets, and booking alerts
RESEND_API_KEY="re_live_xxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender address matching your verified DNS domain in Resend
EMAIL_FROM="GlamBook Concierge <concierge@glambook.in>"
